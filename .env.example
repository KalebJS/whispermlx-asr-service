# whispermlx ASR Service Configuration
# Native Apple-Silicon / MLX service

# ---------------------------------------------------------------------------
# Hugging Face Token (REQUIRED for speaker diarization)
# ---------------------------------------------------------------------------
# Get your token from https://huggingface.co/settings/tokens
# Accept the model agreement for:
#   https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=your_huggingface_token_here

# ---------------------------------------------------------------------------
# Device Configuration (MLX device semantics)
# ---------------------------------------------------------------------------
# DEVICE controls where VAD, wav2vec2 alignment, and pyannote diarization
# (torch-based stages) run.  MLX Whisper ASR always runs on the Metal GPU
# automatically regardless of this setting.
#
# Options:
#   mps   - Use Apple MPS for torch stages (default, recommended — matches whispermlx upstream)
#   cpu   - Fallback if MPS is unstable; diarization will be much slower
DEVICE=mps

# Alignment stage device (defaults to DEVICE). Set to cpu to keep the
# Wav2Vec2 alignment model off the Metal GPU, at the cost of slower word
# timestamps.
#ALIGN_DEVICE=cpu

# ---------------------------------------------------------------------------
# Compute Type & Batch Size (accepted but INERT under MLX)
# ---------------------------------------------------------------------------
# These are read for API compatibility with the original CUDA-based service
# but have NO EFFECT on the MLX backend.  Whispermlx ignores compute_type
# and batch_size; setting them will not error but will not change inference
# behaviour either.
#COMPUTE_TYPE=int8
#BATCH_SIZE=2

# ---------------------------------------------------------------------------
# Model Cache Directories
# ---------------------------------------------------------------------------
# Where downloaded Whisper and alignment models are stored.
CACHE_DIR=~/.cache/whisperx-asr
# Hugging Face cache (pyannote diarization models); set to same as CACHE_DIR
# for unified caching.  Enables offline use after models are downloaded once.
HF_HOME=~/.cache/whisperx-asr

# Offline mode (OPTIONAL): set to 1 to prevent network requests to Hugging Face.
# Requires all models to be cached first (run once with internet access).
#HF_HUB_OFFLINE=1

# ---------------------------------------------------------------------------
# Model Preloading (OPTIONAL)
# ---------------------------------------------------------------------------
# Preload a specific model on startup to reduce first-request latency.
# Also sets the default model for /asr requests when no model= param is given.
# Options: tiny, tiny.en, base, base.en, small, small.en, medium, medium.en,
#          large, large-v1, large-v2, large-v3, large-v3-turbo, turbo
# Leave empty or comment out to disable preloading.
PRELOAD_MODEL=large-v3

# Override which model the OpenAI "whisper-1" alias resolves to.
# Defaults to the PRELOAD_MODEL value, or large-v3 if unset.
#OPENAI_WHISPER1_MODEL=large-v3

# ---------------------------------------------------------------------------
# Service Port
# ---------------------------------------------------------------------------
# The service binds to this port.  Default is 9001.
# NOTE: entrypoint.sh hardcodes 9001; this is only respected when
# launching uvicorn directly with --port $PORT.
# (Port 9000 is reserved on this host; use the 9001-9010 range.)
PORT=9001

# ---------------------------------------------------------------------------
# Upload Limits
# ---------------------------------------------------------------------------
# Maximum audio file size in MB.  Default: 1000 MB (1 GB).
# MAX_FILE_SIZE_MB=1000

# ---------------------------------------------------------------------------
# GPU Concurrency & Queue
# ---------------------------------------------------------------------------
# Number of concurrent pipeline runs through the Metal GPU semaphore.
# Default: 1 (single-device serialisation).
# GPU_CONCURRENCY=1
# Maximum queued requests before rejecting with 503.  Default: 32.
# MAX_QUEUE_SIZE=32

# ---------------------------------------------------------------------------
# Idle Model Eviction (OPTIONAL)
# ---------------------------------------------------------------------------
# Unload Whisper models from memory after this many seconds of inactivity.
# The next request that needs the model will reload it transparently.
# Default 0 = disabled (models stay loaded indefinitely).
# Useful when you serve multiple models in rotation and want to reclaim memory.
# MODEL_KEEP_ALIVE_SECONDS=3600

# Sweep cadence for the eviction daemon (floor 30 seconds).
# MODEL_EVICTION_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# Diarization Hyperparameter Tuning (OPTIONAL)
# ---------------------------------------------------------------------------
# Tune the pyannote community-1 pipeline when speakers get merged or short
# turns get missed. All unset by default = the model's published defaults
# (output unchanged unless you opt in). The pipeline's full default parameter
# schema is logged at startup, so you can see the exact keys for your version.
#
# Main lever for merged/missed speakers. community-1 default is 0.6. Lower it
# (e.g. 0.5) to split similar/merged voices more aggressively; raise it for
# fewer speakers. Useful range ~0.4-0.8. (In testing, 0.6 -> 0.5 recovered a
# third speaker that the default merged into one label.)
# DIARIZE_CLUSTERING_THRESHOLD=0.5
#
# Non-speech gaps shorter than this (seconds) are filled, MERGING the turns on
# either side. community-1 default is 0.0. Raise it (e.g. 0.1-0.5) to suppress
# over-segmentation. It does NOT recover rapid turns (the default is already
# 0.0); use the clustering threshold above for that.
# DIARIZE_MIN_DURATION_OFF=0.2
#
# Escape hatch: a JSON object deep-merged into the pipeline's instantiated
# parameters, for any key the two vars above don't cover. The community-1
# schema also exposes clustering.Fa (false-alarm weight, default 0.07) and
# clustering.Fb (missed-detection weight, default 0.8). Use the schema printed
# in the startup logs to confirm valid keys.
# DIARIZE_PARAM_OVERRIDES={"clustering": {"Fb": 1.0}}
#
# Assign the nearest speaker to words/segments that fall outside every
# diarization turn, instead of leaving them with no speaker label. Fixes
# "orphan" segments (e.g. a closing line that shows up untagged). Default
# false. Trade-off: a long silence may occasionally be tagged with a speaker.
# DIARIZE_FILL_NEAREST=false

# ---------------------------------------------------------------------------
# ASR Backend (experimental)
# ---------------------------------------------------------------------------
# whisper (default) = whispermlx/MLX, native Apple Silicon.
# qwen3 = Qwen3-ASR transcription + Qwen3 forced aligner. The aligner is
# language-agnostic across its supported set, which handles code-switched
# audio (e.g. Chinese/English) that per-language Wav2Vec2 alignment cannot.
# hotwords/initial_prompt become free-text context biasing (unlike the
# whisper backend, where hotwords are a documented no-op). Ignores the
# requested Whisper model name; task=translate falls back to whisper.
# Requires transformers >= 5.13 (pinned in pyproject.toml). Weights (~4.6 GB)
# download into the HF cache on first use.
# ASR_BACKEND=qwen3
#
# Execution runtime for the qwen3 backend:
#   auto (default) -> native MLX (via mlx-qwen3-asr, fp16 on the Metal GPU)
#       on machines without CUDA; stock transformers (torch) otherwise.
#   mlx  -> require the native MLX runtime (Metal only; also loads the
#       mlx-community/moona3k quantized checkpoints).
#   torch-> stock transformers (needed for CUDA; runs fp32 otherwise).
# The MLX runtime transcribes with word timestamps in one pass, chunks at
# pauses, and its aligner is ~2.6x faster than the PyTorch one.
# QWEN3_RUNTIME=auto
#
# Override the Qwen model checkpoints (torch-path defaults shown).
# The MLX runtime defaults to Qwen/Qwen3-ASR-1.7B +
# Qwen/Qwen3-ForcedAligner-0.6B (official repos, converted on first load);
# point these at mlx-community/moona3k quantized checkpoints for faster load
# and inference.
# QWEN3_ASR_MODEL=Qwen/Qwen3-ASR-1.7B-hf
# QWEN3_ALIGNER_MODEL=Qwen/Qwen3-ForcedAligner-0.6B-hf
#
# Audio chunk length in seconds (torch runtime; default 90). The encoder
# handles up to ~300 s, but shorter chunks are less prone to truncation and
# repetition loops on difficult audio. The MLX runtime chunks at pauses
# instead.
# QWEN3_CHUNK_SECONDS=90
#
# Standing vocabulary/context biasing text prepended to every request's
# context (same mechanism as per-request hotwords). Note: this cannot fix
# mixed-language handling. For code-switched audio a per-request language is
# required; without one the model picks the dominant language per chunk and
# translates the rest into it.
# QWEN3_DEFAULT_CONTEXT=

# ---------------------------------------------------------------------------
# External ASR Backend (experimental)
# ---------------------------------------------------------------------------
# ASR_BACKEND=external outsources ONLY the transcription stage to an
# OpenAI-compatible API; alignment, diarization, and speaker embeddings
# keep running locally. NOTE: your audio is uploaded to the provider.
#
# EXTERNAL_ASR_MODE=transcriptions (default) posts to
# {base}/audio/transcriptions (whisper-1, Groq, self-hosted Whisper
# servers). Providers that return timestamped segments use the local
# Wav2Vec2 alignment; text-only responses are word-timestamped by the
# Qwen forced aligner instead (~1.2 GB, downloads on first use).
# EXTERNAL_ASR_MODE=chat posts base64 audio to {base}/chat/completions
# (OpenRouter audio models such as Voxtral, vLLM multimodal servers);
# these are text-only and always use the Qwen forced aligner.
# ASR_BACKEND=external
# EXTERNAL_ASR_BASE_URL=https://api.openai.com/v1
# EXTERNAL_ASR_API_KEY=sk-...
# EXTERNAL_ASR_MODEL=whisper-1
# EXTERNAL_ASR_MODE=transcriptions
#
# Force the Qwen forced aligner even when the provider returns timestamped
# segments (useful for code-switched audio or languages without a good
# Wav2Vec2 model). "auto" (default) picks by response shape.
# EXTERNAL_ASR_ALIGNER=qwen

# ---------------------------------------------------------------------------
# Speaker-Turn Resegmentation (OPTIONAL)
# ---------------------------------------------------------------------------
# When true, segments are rebuilt at speaker-change boundaries after
# diarization (using per-word speaker labels), so rapid turns are not merged
# into one speaker's segment. Changes the segment shape existing callers may
# rely on, so it is opt-in. The word_timestamps=false path already re-splits
# along diarization turns unconditionally.
# RESEGMENT_BY_SPEAKER=false
